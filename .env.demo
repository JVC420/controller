# Demo LOCAL con Firebase Emulators (npm run demo)
# Los valores de API key/appId son irrelevantes — los emulators no validan.
VITE_DEMO=true
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-lma.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-lma
VITE_FIREBASE_STORAGE_BUCKET=demo-lma.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
